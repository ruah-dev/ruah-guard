{
	"schemaVersion": "1",
	"criteria": [
		{
			"id": "readme-question",
			"description": "README leads with the one-line question",
			"check": {
				"type": "file_matches",
				"path": "README.md",
				"pattern": "Can I trust the agent not to do damage"
			}
		},
		{
			"id": "package-json",
			"description": "package.json is valid JSON",
			"check": { "type": "json_valid", "file": "package.json" }
		},
		{
			"id": "cli-exists",
			"description": "CLI entry exists",
			"check": { "type": "file_exists", "path": "src/cli.ts" }
		}
	]
}
